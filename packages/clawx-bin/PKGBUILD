# Maintainer: PaloMiku <palomiku@outlook.com>

pkgname=clawx-bin
_pkgname=${pkgname%-bin}
pkgver="0.5.3"
pkgrel=1
pkgdesc="Desktop interface for OpenClaw AI agents"
arch=('x86_64' 'aarch64')
url='https://github.com/ValueCell-ai/ClawX'
license=('MIT')
depends=('gtk3' 'libnotify' 'nss' 'libxss' 'libxtst' 'xdg-utils' 'at-spi2-core')
provides=("${_pkgname}")
conflicts=("${_pkgname}")
source_x86_64=("ClawX-0.5.3-linux-amd64.deb::https://github.com/ValueCell-ai/ClawX/releases/download/v0.5.3/ClawX-0.5.3-linux-amd64.deb")
sha512sums_x86_64=('c690c30ad27dfc0ebc9d2bf6d7cb4c8c5032bd8ec10a5e652692b5886a79249a10d63d5952592147b5d547b974bfdb08122492b4473df0905a27c1324691c56c')
source_aarch64=("ClawX-0.5.3-linux-arm64.deb::https://github.com/ValueCell-ai/ClawX/releases/download/v0.5.3/ClawX-0.5.3-linux-arm64.deb")
sha512sums_aarch64=('75d525b6b980f11e31f7e1f8bc498df04731fb7dbb24f1fd5fa9f68a6e9594527bb141bcfd70ad9183a2bf5cb0a1b4d39e8e3f68b130503fd20e6f2a253a432b')

package() {
    local _debdir="${srcdir}/deb-extract"
    local _datadir="${srcdir}/deb-data"
    local _data_archive
    local _deb_arch

    case "${CARCH}" in
        x86_64) _deb_arch='amd64' ;;
        aarch64) _deb_arch='arm64' ;;
        *) echo "Unsupported architecture: ${CARCH}" >&2; return 1 ;;
    esac

    rm -rf "${_debdir}" "${_datadir}"
    mkdir -p "${_debdir}" "${_datadir}"

    cd "${_debdir}"
    ar x "${srcdir}/ClawX-${pkgver}-linux-${_deb_arch}.deb"

    _data_archive=$(printf '%s\n' data.tar.*)
    bsdtar -xf "${_data_archive}" -C "${_datadir}"

    cp -a "${_datadir}/." "${pkgdir}/"
}
